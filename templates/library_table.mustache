{{!
    @template mod_videolesson/library_table

    AJAX-driven video table for the library page.
}}

<div id="videolesson-table-wrapper" class="videolesson-table-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="text-muted d-flex align-items-center flex-wrap">
            <span>
                {{#str}}manage:videos:total, mod_videolesson, {{pagination.total}}{{/str}}
            </span>
            <button type="button" class="btn btn-link p-0 ml-1 videolesson-refresh-table"
                    title="{{#str}}refresh, core{{/str}}"
                    aria-label="{{#str}}refresh, core{{/str}}">
                <i class="icon fa fa-sync" aria-hidden="true"></i>
            </button>
            {{#filters.active}}
            <span class="ml-2 small">
                {{#filters.search}}
                <span class="badge badge-info videolesson-filter-badge" data-filter-type="search">
                    {{#str}}filter:text, mod_videolesson{{/str}}: "{{filters.search}}"
                    <button type="button" class="videolesson-remove-filter ml-1" aria-label="{{#str}}removefilter, mod_videolesson{{/str}}" title="{{#str}}removefilter, mod_videolesson{{/str}}">
                        <i class="icon fa fa-times" aria-hidden="true"></i>
                    </button>
                </span>
                {{/filters.search}}
                {{#filters.foldername}}
                <span class="badge badge-info ml-1 videolesson-filter-badge" data-filter-type="folder">
                    {{#str}}filter:folder, mod_videolesson{{/str}}: "{{filters.foldername}}"
                    <button type="button" class="videolesson-remove-filter ml-1" aria-label="{{#str}}removefilter, mod_videolesson{{/str}}" title="{{#str}}removefilter, mod_videolesson{{/str}}">
                        <i class="icon fa fa-times" aria-hidden="true"></i>
                    </button>
                </span>
                {{/filters.foldername}}
            </span>
            {{/filters.active}}
        </div>
        <div class="text-muted videolesson-table-totalsize">
            {{#str}}manage:videos:totalsize, mod_videolesson, {{totalsize_gb}}{{/str}}
        </div>
    </div>
    <div id="videolesson-bulk-actions" class="d-none mb-2">
        <button type="button" class="btn btn-primary btn-sm videolesson-bulk-move">
            <i class="icon fa fa-folder-open" aria-hidden="true"></i> {{#str}}bulk:move, mod_videolesson{{/str}}
        </button>
        {{^is_bbb_folder}}
        <button type="button" class="btn btn-danger btn-sm videolesson-bulk-delete">
            <i class="icon fa fa-trash" aria-hidden="true"></i> {{#str}}bulk:delete, mod_videolesson{{/str}}
        </button>
        {{/is_bbb_folder}}
        <span class="ml-2 text-muted" id="videolesson-selected-count">0 {{#str}}bulk:selected_count, mod_videolesson{{/str}}</span>
    </div>
    <div class="table-responsive">
        <table class="table table-striped table-hover" id="videolesson-table" {{#is_bbb_folder}}data-bbb-folder="1"{{/is_bbb_folder}}>
            <thead>
                <tr>
                    <th>&nbsp;</th>
                    <th>
                        <input type="checkbox" id="videolesson-select-all" title="{{#str}}bulk:select_all, mod_videolesson{{/str}}" aria-label="{{#str}}bulk:select_all, mod_videolesson{{/str}}">
                    </th>
                    {{#is_bbb_folder}}
                    <th class="videolesson-sortable" data-sort-column="title">{{#str}}form:bbb:col:recordingname, mod_videolesson{{/str}} <span class="sort-indicator"></span></th>
                    <th class="videolesson-sortable" data-sort-column="course">{{#str}}col:bbb:course, mod_videolesson{{/str}} <span class="sort-indicator"></span></th>
                    <th class="videolesson-sortable" data-sort-column="activity">{{#str}}col:bbb:activity, mod_videolesson{{/str}} <span class="sort-indicator"></span></th>
                    <th class="videolesson-sortable" data-sort-column="status">{{#str}}col:vid:status, mod_videolesson{{/str}} <span class="sort-indicator"></span></th>
                    {{/is_bbb_folder}}
                    {{^is_bbb_folder}}
                    <th class="videolesson-sortable" data-sort-column="title">{{#str}}col:vid:title, mod_videolesson{{/str}} <span class="sort-indicator"></span></th>
                    <th class="videolesson-sortable" data-sort-column="folder">{{#str}}col:folder, mod_videolesson{{/str}} <span class="sort-indicator"></span></th>
                    <th class="videolesson-sortable" data-sort-column="status">{{#str}}col:vid:status, mod_videolesson{{/str}} <span class="sort-indicator"></span></th>
                    {{/is_bbb_folder}}
                    <th class="videolesson-sortable" data-sort-column="instances">{{#str}}col:vid:instances, mod_videolesson{{/str}} <span class="sort-indicator"></span></th>
                    <th class="videolesson-sortable" data-sort-column="timecreated">{{#str}}col:timecreated, mod_videolesson{{/str}} <span class="sort-indicator"></span></th>
                    <th>{{#str}}col:action, mod_videolesson{{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#hasvideos}}
                    {{#videos}}
                    <tr class="videolesson-draggable-row{{#is_bbb}} videolesson-bbb-row{{/is_bbb}}"
                        data-videolesson-id="{{id}}"
                        {{#is_bbb}}data-bbb="1" data-recording-id="{{recordingid}}"{{/is_bbb}}
                        data-folder-id="{{#folderid}}{{folderid}}{{/folderid}}{{^folderid}}null{{/folderid}}"
                        data-sort-title="{{title}}"
                        data-sort-folder="{{foldername}}"
                        data-sort-status="{{status}}"
                        data-sort-course="{{coursename}}"
                        data-sort-activity="{{activityname}}"
                        data-sort-instances="{{instances}}"
                        data-sort-timecreated="{{timecreatedtimestamp}}">
                        <td class="align-middle text-center">
                            <span class="videolesson-drag-handle" draggable="true"
                                  title="{{#str}}folder:drag_handle, mod_videolesson{{/str}}">
                                <i class="icon fa fa-grip-vertical" aria-hidden="true"></i>
                            </span>
                        </td>
                        <td class="align-middle text-center">
                            <input type="checkbox"
                                   class="videolesson-video-checkbox"
                                   data-video-id="{{id}}"
                                   data-contenthash="{{contenthash}}"
                                   {{#is_bbb}}data-recording-id="{{recordingid}}"{{/is_bbb}}
                                   {{#checkbox_disabled}}disabled{{/checkbox_disabled}}
                                   aria-label="{{#str}}bulk:select_video, mod_videolesson{{/str}}">
                        </td>
                        <td style="min-width: 280px;">
                            <div class="d-flex align-items-center">
                                {{#is_bbb}}
                                <div class="videolesson-bbb-thumb mr-2{{#viewaction}} videolesson-viewmodal-thumbnail{{/viewaction}}"
                                     {{#viewaction}}
                                     data-videolesson-src="{{src}}"
                                     data-videolesson-contenthash="{{contenthash}}"
                                     data-videolesson-title="{{title}}"
                                     data-videolesson-ishls="{{#ishls}}1{{/ishls}}{{^ishls}}0{{/ishls}}"
                                     data-videolesson-type="{{#type}}{{type}}{{/type}}"
                                     {{/viewaction}}
                                     role="{{#viewaction}}button{{/viewaction}}{{^viewaction}}presentation{{/viewaction}}">
                                    <img src="{{thumbnail}}"
                                         alt=""
                                         onerror="this.onerror=null; this.src='{{placeholder}}';">
                                </div>
                                {{/is_bbb}}
                                {{^is_bbb}}
                                <div class="videolesson-library-thumb mr-2{{#viewaction}} videolesson-viewmodal-thumbnail{{/viewaction}}"
                                     {{#viewaction}}
                                     data-videolesson-src="{{src}}"
                                     data-videolesson-contenthash="{{contenthash}}"
                                     data-videolesson-title="{{title}}"
                                     data-videolesson-ishls="{{#ishls}}1{{/ishls}}{{^ishls}}0{{/ishls}}"
                                     data-videolesson-type="{{#type}}{{type}}{{/type}}"
                                     {{/viewaction}}
                                     role="{{#viewaction}}button{{/viewaction}}{{^viewaction}}presentation{{/viewaction}}">
                                    <img src="{{thumbnail}}"
                                         alt=""
                                         onerror="this.onerror=null; this.src='{{placeholder}}';">
                                </div>
                                {{/is_bbb}}
                                <div>
                                    {{{namehtml}}}
                                    <div class="small text-muted">{{duration}}</div>
                                    {{#is_bbb}}
                                        {{^is_bbb_folder}}
                                        <div class="small text-muted">{{#str}}col:bbb:course, mod_videolesson{{/str}}: {{coursename}}, {{#str}}col:bbb:activity, mod_videolesson{{/str}} : {{activityname}}</div>
                                        {{/is_bbb_folder}}
                                    {{/is_bbb}}
                                    {{^is_bbb}}
                                    <div class="small text-muted">{{#str}}col:vid:size, mod_videolesson{{/str}}: {{size}}, {{#str}}col:vid:source_size, mod_videolesson{{/str}}: {{sourcesize}}</div>
                                    {{/is_bbb}}
                                </div>
                            </div>
                        </td>
                        {{#is_bbb_folder}}
                        <td>{{coursename}}</td>
                        <td>{{activityname}}</td>
                        <td>
                            {{#status}}
                                <span class="badge badge-{{statusbadge}}">{{status}}</span>
                            {{/status}}
                        </td>
                        {{/is_bbb_folder}}
                        {{^is_bbb_folder}}
                        <td>
                            <span class="videolesson-folder-name">{{foldername}}</span>
                        </td>
                        <td>
                            {{#status}}
                                <span class="badge badge-{{statusbadge}}">{{status}}</span>
                            {{/status}}
                        </td>
                        {{/is_bbb_folder}}
                        <td>
                            {{#instancesurl}}
                                <a href="{{instancesurl}}" target="_blank">{{instances}}</a>
                            {{/instancesurl}}
                            {{^instancesurl}}
                                {{instances}}
                            {{/instancesurl}}
                        </td>
                        <td>{{timecreated}}</td>
                        <td class="videolesson-actions-cell">
                            <div class="btn-group">
                                {{#viewaction}}
                                <button type="button"
                                    class="btn btn-transparent videolesson-viewmodal-data"
                                    data-videolesson-src="{{src}}"
                                    data-videolesson-contenthash="{{contenthash}}"
                                    data-videolesson-title="{{title}}"
                                    data-videolesson-ishls="{{#ishls}}1{{/ishls}}{{^ishls}}0{{/ishls}}"
                                    data-videolesson-type="{{#type}}{{type}}{{/type}}"
                                    title="{{#str}}view, moodle{{/str}}">
                                    <i class="icon fa fa-play fa-fw m-0 mr-1" aria-hidden="true"></i>
                                    {{#str}}manage:video:play, mod_videolesson{{/str}}
                                </button>
                                {{/viewaction}}
                                {{^viewaction}}
                                <button type="button" class="btn btn-transparent" disabled title="{{#str}}view, moodle{{/str}}">
                                    <i class="icon fa fa-play fa-fw m-0 mr-1" aria-hidden="true"></i>
                                    {{#str}}manage:video:play, mod_videolesson{{/str}}
                                </button>
                                {{/viewaction}}
                                <button type="button"
                                    class="btn btn-transparent btn-no-after dropdown-toggle dropdown-toggle-split"
                                    data-bs-toggle="dropdown"
                                    data-toggle="dropdown"
                                    aria-haspopup="true"
                                    aria-expanded="false"
                                    title="{{#str}}col:action, mod_videolesson{{/str}}">
                                    <i class="icon fa fa-ellipsis-v fa-fw m-0" role="img" aria-hidden="true"></i>
                                </button>
                                <div class="dropdown-menu dropdown-menu-end">
                                    {{#mp4action}}
                                    <a class="dropdown-item" href="{{url}}" target="_blank">
                                        <i class="icon fa fa-download fa-fw me-2" aria-hidden="true"></i>
                                        {{#str}}manage:video:mp4, mod_videolesson{{/str}}
                                    </a>
                                    {{/mp4action}}
                                    {{#zipdownloadaction}}
                                    <a class="dropdown-item" href="{{url}}" target="_blank" rel="noopener noreferrer">
                                        <i class="icon fa fa-file-archive fa-fw me-2" aria-hidden="true"></i>
                                        {{label}}
                                    </a>
                                    {{/zipdownloadaction}}
                                    {{#assignable}}
                                    <button type="button"
                                        class="dropdown-item videolesson-assign-folder"
                                        data-videolesson-id="{{id}}"
                                        {{#is_bbb}}data-recording-id="{{recordingid}}" data-bbb="1"{{/is_bbb}}
                                        data-current-folder="{{#folderid}}{{folderid}}{{/folderid}}{{^folderid}}null{{/folderid}}"
                                        data-video-title="{{title}}">
                                        <i class="icon fa fa-folder-open fa-fw me-2" aria-hidden="true"></i>
                                        {{#str}}folder:assign, mod_videolesson{{/str}}
                                    </button>
                                    {{/assignable}}
                                    {{#reporturl}}
                                    <a class="dropdown-item" href="{{reporturl}}" target="_blank">
                                        <i class="icon fa fa-chart-line fa-fw me-2" aria-hidden="true"></i>
                                        {{#str}}report, mod_videolesson{{/str}}
                                    </a>
                                    {{/reporturl}}
                                    {{#cansubtitle}}
                                    <button type="button"
                                        class="dropdown-item videolesson-trigger-subtitle"
                                        data-contenthash="{{contenthash}}"
                                        data-video-name="{{title}}">
                                        <i class="icon fa fa-closed-captioning fa-fw me-2" aria-hidden="true"></i>
                                        {{#str}}subtitle:generate, mod_videolesson{{/str}}
                                    </button>
                                    {{/cansubtitle}}
                                    {{#retryurl}}
                                    <a class="dropdown-item" href="{{retryurl}}">
                                        <i class="icon fa fa-redo fa-fw me-2" aria-hidden="true"></i>
                                        {{#str}}manage:video:upload:retry, mod_videolesson{{/str}}
                                    </a>
                                    {{/retryurl}}
                                    {{#deleteurl}}
                                    <a class="dropdown-item text-danger videolesson-delete-link"
                                       href="{{deleteurl}}"
                                       data-video-id="{{id}}"
                                       data-contenthash="{{contenthash}}"
                                       data-video-name="{{title}}">
                                        <i class="icon fa fa-trash fa-fw me-2" aria-hidden="true"></i>
                                        {{#str}}delete, moodle{{/str}}
                                    </a>
                                    {{/deleteurl}}
                                </div>
                            </div>
                        </td>
                    </tr>
                    {{/videos}}
                {{/hasvideos}}
                {{^hasvideos}}
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">
                            {{#str}}nothingtodisplay, moodle{{/str}}
                        </td>
                    </tr>
                {{/hasvideos}}
            </tbody>
        </table>
    </div>

    {{#pagination.haspages}}
    <nav aria-label="Video pagination" class="mt-3">
        <ul class="pagination">
            <li class="page-item {{^pagination.hasprev}}disabled{{/pagination.hasprev}}">
                <a class="page-link videolesson-page-link" href="#" data-page="{{pagination.prevpage}}">&laquo;</a>
            </li>
            {{#pagination.pages}}
                <li class="page-item {{#current}}active{{/current}}">
                    <a class="page-link videolesson-page-link" href="#" data-page="{{number}}">{{display}}</a>
                </li>
            {{/pagination.pages}}
            <li class="page-item {{^pagination.hasnext}}disabled{{/pagination.hasnext}}">
                <a class="page-link videolesson-page-link" href="#" data-page="{{pagination.nextpage}}">&raquo;</a>
            </li>
        </ul>
    </nav>
    {{/pagination.haspages}}
</div>
