{{!
    @template mod_videolesson/form_bbb_recordings

    BBB recording picker embedded in the activity mod form.
}}

<div id="bbb_recordings_container" class="form-group row fitem d-none">
    <div class="col-md-3 col-form-label d-flex pb-0 pr-md-0">
            <label id="bbblist_label" class="d-inline word-break " for="bbblist">
                {{#str}}form:bbb:selectrecording, mod_videolesson{{/str}}
            </label>
        <div class="form-label-addon d-flex align-items-center align-self-start">
        </div>
    </div>
    <div class="col-md-9 align-items-start felement">
        <div class="border rounded p-2">
            {{^hasrecordings}}
            <div class="alert alert-info mb-0">{{#str}}form:bbb:empty, mod_videolesson{{/str}}</div>
            {{/hasrecordings}}
            {{#hasrecordings}}
            <input type="text" id="bbblistsearchinput" class="mb-2" style="border-radius: .5rem; padding: .375rem .75rem; border: 1px solid #8f959e;" placeholder="Search">
            <div>
                <table id="bbblist" class="display videolist" style="width:100%" data-selected="">
                    <thead>
                        <tr>
                            <th>{{#str}}form:bbb:col:course, mod_videolesson{{/str}}</th>
                            <th>{{#str}}form:bbb:col:activity, mod_videolesson{{/str}}</th>
                            <th>{{#str}}form:bbb:col:recordingname, mod_videolesson{{/str}}</th>
                            <th>{{#str}}form:bbb:col:duration, mod_videolesson{{/str}}</th>
                            <th>{{#str}}form:bbb:col:date, mod_videolesson{{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#recordings}}
                        <tr data-recordingid="{{recordingid}}" data-title="{{#shortentext}} 50, {{{name}}} {{/shortentext}}" class="{{#selected}}selected{{/selected}}">
                            <td>{{#shortentext}} 40, {{{coursename}}} {{/shortentext}}</td>
                            <td>{{#shortentext}} 40, {{{activityname}}} {{/shortentext}}</td>
                            <td>{{#shortentext}} 50, {{{name}}} {{/shortentext}}</td>
                            <td>{{duration}}</td>
                            <td>{{timecreated}}</td>
                        </tr>
                        {{/recordings}}
                    </tbody>
                </table>
            </div>
            {{/hasrecordings}}
        </div>
    </div>
</div>