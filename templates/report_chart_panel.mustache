{{!
    @template mod_videolesson/report_chart_panel

    Heading shown above a report chart.

    Example context (json):
    {
        "eyebrow": "Video engagement",
        "title": "Views by video time",
        "subtitle": "View activity across the video timeline",
        "haslegend": true,
        "legend": [{ "label": "Views", "color": "#3f6ab2" }],
        "chart": ""
    }
}}
<section class="videolesson-chart-panel">
    <div class="videolesson-chart-panel-header">
        <div>
            <p class="videolesson-chart-kicker">{{eyebrow}}</p>
            <h3 class="videolesson-chart-title">{{title}}</h3>
            <p class="videolesson-chart-subtitle">{{subtitle}}</p>
        </div>
        {{#haslegend}}
        <ul class="videolesson-chart-legend">
            {{#legend}}
            <li><span style="background-color: {{color}};"></span>{{label}}</li>
            {{/legend}}
        </ul>
        {{/haslegend}}
    </div>
    <div class="videolesson-chart-panel-body">
        {{{chart}}}
    </div>
</section>
