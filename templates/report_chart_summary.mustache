{{!
    @template mod_videolesson/report_chart_summary

    Summary card for a distribution that has only one category.

    Example context (json):
    {
        "label": "Desktop",
        "summary": "12 (100%)"
    }
}}
<div class="card videolesson-chart-summary">
    <div class="card-body">
        <h3 class="h5 card-title mb-1">{{label}}</h3>
        <p class="card-text mb-0">{{summary}}</p>
    </div>
</div>
